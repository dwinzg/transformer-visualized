---
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import katex from 'katex';
import type { LlamaTrace, Trace } from '@transformer-visualized/engine';
import Figure from '../../components/Figure.astro';
import ArchitectureMap, { type Article } from '../../components/figures/ArchitectureMap.tsx';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOUR, BLOCKS } from '../../lib/architecture-layout';
import { formulaFor, PARTS, VIEWS, type PartId, type View } from '../../lib/concepts';
import { llamaTraceOf, traceOf } from '../../lib/demo-data';
import { withBase } from '../../lib/paths';
import Ref from '../../components/mdx/Ref.astro';
import {
  LLAMA_PYTORCH,
  LLAMA_SECOND_NORM,
  LLAMA_SETUP,
  PYTORCH,
  SECOND_NORM,
  SETUP,
  type Snippet,
} from '../../lib/pytorch';

// Draft chapters get no page, so they count as missing.
const chapters = new Set(
  (await getCollection('chapters', ({ data }) => !data.draft)).map((chapter) => chapter.id),
);
const glossary = new Set((await getCollection('glossary')).map((entry) => entry.id));

// Formulas are rendered here at build time, so the page ships no KaTeX JavaScript.
const formulas: Partial<Record<PartId, Partial<Record<View, string>>>> = {};
const links: Partial<Record<PartId, { chapter?: string; glossary?: string }>> = {};
for (const part of Object.values(PARTS)) {
  for (const view of VIEWS) {
    const tex = formulaFor(part, view);
    if (tex) {
      (formulas[part.id] ??= {})[view] = katex.renderToString(tex, {
        displayMode: true,
        throwOnError: true,
        output: 'htmlAndMathml',
      });
    }
  }
  links[part.id] = {
    chapter:
      part.chapter && chapters.has(part.chapter)
        ? withBase(`learn/${part.chapter}/${part.step ? `#${part.step}` : ''}`)
        : undefined,
    glossary:
      part.glossary && glossary.has(part.glossary)
        ? withBase(`glossary/#${part.glossary}`)
        : undefined,
  };
}

// What each snippet prints comes from one run of our engine, so the page and PyTorch agree.
const trace = traceOf('Lily wanted to play with her');
const llamaTrace = llamaTraceOf('Lily wanted to play with her');
const toArticle = (snippet: Snippet, from: Trace | LlamaTrace = trace): Article => ({
  shape: snippet.shape,
  code: snippet.code,
  prints: snippet.prints?.(from),
  paper: snippet.paper,
});
const articlesFrom = (
  snippets: Partial<Record<PartId, Snippet>>,
  from: Trace | LlamaTrace = trace,
) => {
  const out: Partial<Record<PartId, Article>> = {};
  for (const [id, snippet] of Object.entries(snippets) as [PartId, Snippet][]) {
    out[id] = toArticle(snippet, from);
  }
  return out;
};
const articles = articlesFrom(PYTORCH);
const llama = {
  articles: articlesFrom(LLAMA_PYTORCH, llamaTrace),
  secondNorm: toArticle(LLAMA_SECOND_NORM, llamaTrace),
  setup: LLAMA_SETUP,
};

// The text version follows the paper's tour, then adds the part only GPT-2 has.
const outline = [
  ...new Set([...TOUR.original, ...TOUR.gpt2].map((id) => BLOCKS.find((b) => b.id === id)!.part)),
].map((id) => PARTS[id]);
---

<BaseLayout
  title="The whole model"
  description="A clickable map of the transformer, from the input text to the next-token guess."
>
  <section class="prose page">
    <h1>The whole model</h1>
    <p class="lede">
      Tap any part to see what it does, then read more about it below the map. Or press Next for a
      guided tour.
    </p>
    <Figure
      caption="Redrawn from Figure 1 of Vaswani et al. 2017."
      description="The transformer drawn as stacked blocks, from the inputs at the bottom to the output probabilities at the top. Each block is a button that explains that part."
    >
      <Fragment slot="caption">
        Redrawn from Figure 1 of{' '}
        <a href={withBase('references/#vaswani2017')}>Vaswani et al. 2017</a>.
      </Fragment>
      <ArchitectureMap
        client:visible
        formulas={formulas}
        links={links}
        articles={articles}
        secondNorm={toArticle(SECOND_NORM)}
        setup={SETUP}
        llama={llama}
      />
    </Figure>
    <p class="credit">
      The paper is listed on the <a href={withBase('references/#vaswani2017')}>references page</a>.
      GPT-2 keeps only the right-hand side, because it continues text instead of translating it.
    </p>
    <!-- prettier-ignore -->
    <p class="credit">
      The Llama style view shows our second model, with the changes most models since have made. LLaMA brought RMSNorm, rotary positions and the SwiGLU feed forward (<Ref id="touvron2023" />), and Llama 2's larger models added grouped-query attention (<Ref id="touvron2023b" />).
    </p>
    <p class="credit">
      Prompts, retrieval, tools and reasoning all use this same model. See how in{' '}
      <a href={withBase('learn/context/')}>Context and prompts</a> and the chapters after it.
    </p>
    <div id="part-article" class="part-article">
      <p>The list below describes every part.</p>
    </div>
    <details class="outline">
      <summary>Every part as a list</summary>
      <p>The same parts as the map, in order, for reading without it.</p>
      <ol>
        {outline.map((part) => (
          <li>
            <strong>{part.title}.</strong> {part.story} {part.notes?.original} {part.notes?.gpt2}
          </li>
        ))}
      </ol>
    </details>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12);
  }
  .lede,
  .credit {
    color: var(--color-text-secondary);
  }
  .outline {
    margin-top: var(--space-6);
  }
  .outline summary {
    min-height: var(--touch-target);
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .outline li {
    margin-bottom: var(--space-2);
  }
</style>
