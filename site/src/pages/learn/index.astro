---
import { getCollection } from 'astro:content';
import DepthDial from '../../components/DepthDial.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

const chapters = (await getCollection('chapters', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const parts = [
  {
    id: 'core',
    title: 'Inside the model',
    chapters: chapters.filter((c) => c.data.part === 'core'),
  },
  {
    id: 'today',
    title: 'Using it today',
    intro: 'How prompts, retrieval, tools and reasoning build on the same model.',
    chapters: chapters.filter((c) => c.data.part === 'today'),
  },
].filter((part) => part.chapters.length > 0);
---

<BaseLayout
  title="Learn"
  description="Chapters that follow one sentence through a transformer, step by step."
>
  <section class="prose page">
    <h1>Learn</h1>
    <p class="intro">
      The first chapters follow one sentence through the model, and the later ones show how it is
      used today. Pick how you want things explained. You can change it at any step.
    </p>
    <DepthDial explain />
    <a class="map-row press" href={withBase('learn/architecture/')}>
      <span class="title">The whole model</span>
      <span class="summary">
        A clickable map of every part, with sizes, formulas and PyTorch code.
      </span>
    </a>
    {parts.map((part) => (
      <section aria-labelledby={`part-${part.id}`}>
        <h2 id={`part-${part.id}`} class="part-title">
          {part.title}
        </h2>
        {part.intro && <p class="part-intro">{part.intro}</p>}
        <ol class="chapters" start={part.chapters[0].data.order}>
          {part.chapters.map((chapter) => (
            <li>
              <a class="press" href={withBase(`learn/${chapter.id}/`)}>
                <span class="token-chip number">
                  <span class="visually-hidden">Chapter </span>
                  {chapter.data.order}
                </span>
                <span class="text">
                  <span class="title">{chapter.data.title}</span>
                  <span class="summary">{chapter.data.summary}</span>
                  <span class="minutes">About {chapter.data.minutes} minutes</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>
</BaseLayout>

<script>
  import { applyDepthFromQuery } from '../../lib/depth';

  // A ?depth= link opens the chapter list at that level.
  applyDepthFromQuery();
</script>

<style>
  .page {
    padding-block: var(--space-12);
  }
  .part-title {
    margin: var(--space-8) 0 var(--space-2);
    font-size: var(--text-title-3);
  }
  .part-intro {
    margin: 0 0 var(--space-3);
    color: var(--color-text-secondary);
  }
  .intro {
    color: var(--color-text-secondary);
  }
  .map-row {
    display: grid;
    gap: var(--space-1);
    min-height: var(--touch-target);
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-1);
    border-top: 1px solid var(--color-separator);
    color: var(--color-text);
    text-decoration: none;
  }
  .map-row:hover .title {
    color: var(--color-accent);
  }
  .chapters {
    list-style: none;
    padding: 0;
    margin-top: 0;
  }
  .chapters a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: baseline;
    min-height: var(--touch-target);
    padding: var(--space-5) var(--space-1);
    border-top: 1px solid var(--color-separator);
    color: var(--color-text);
    text-decoration: none;
  }
  .chapters a:hover .title {
    color: var(--color-accent);
  }
  .number {
    min-width: 2.25rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .text {
    display: grid;
    gap: var(--space-1);
  }
  .title {
    font-size: var(--text-title-3);
    font-weight: 600;
  }
  .summary,
  .minutes {
    color: var(--color-text-secondary);
  }
  .minutes {
    font-size: var(--text-footnote);
  }
</style>
