---
import { getCollection } from 'astro:content';
import DepthDial from '../../components/DepthDial.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';

const chapters = (await getCollection('chapters', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Learn"
  description="Chapters that follow one sentence through a transformer, step by step."
>
  <section class="prose page">
    <h1>Learn</h1>
    <p class="intro">
      Each chapter follows the same sentence through one part of the model. Pick how you want things
      explained. You can change it at any step.
    </p>
    <DepthDial />
    <a class="map-row press" href={withBase('learn/architecture/')}>
      <span class="title">The transformer at a glance</span>
      <span class="summary">
        A clickable map of the whole model, with sizes, formulas and PyTorch for every part.
      </span>
    </a>
    <ol class="chapters">
      {chapters.map((chapter) => (
        <li>
          <a class="press" href={withBase(`learn/${chapter.id}/`)}>
            <span class="token-chip number">
              <span class="visually-hidden">Chapter </span>
              {chapter.data.order}
            </span>
            <span class="text">
              <span class="title">{chapter.data.title}</span>
              <span class="summary">{chapter.data.summary}</span>
              <span class="minutes">About {chapter.data.minutes} minutes</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<script>
  import { applyDepthFromQuery } from '../../lib/depth';

  // A ?depth= link opens the chapter list at that level.
  applyDepthFromQuery();
</script>

<style>
  .page {
    padding-block: var(--space-12);
  }
  .intro {
    color: var(--color-text-secondary);
  }
  .map-row {
    display: grid;
    gap: var(--space-1);
    min-height: var(--touch-target);
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-1);
    border-top: 1px solid var(--color-separator);
    color: var(--color-text);
    text-decoration: none;
  }
  .map-row:hover .title {
    color: var(--color-accent);
  }
  .chapters {
    list-style: none;
    padding: 0;
    margin-top: 0;
  }
  .chapters a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: baseline;
    min-height: var(--touch-target);
    padding: var(--space-5) var(--space-1);
    border-top: 1px solid var(--color-separator);
    color: var(--color-text);
    text-decoration: none;
  }
  .chapters a:hover .title {
    color: var(--color-accent);
  }
  .number {
    min-width: 2.25rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .text {
    display: grid;
    gap: var(--space-1);
  }
  .title {
    font-size: var(--text-title-3);
    font-weight: 600;
  }
  .summary,
  .minutes {
    color: var(--color-text-secondary);
  }
  .minutes {
    font-size: var(--text-footnote);
  }
</style>
