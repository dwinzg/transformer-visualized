---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { mapPath, PARTS } from '../lib/concepts';
import { withBase } from '../lib/paths';

const entries = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term),
);
const termById = new Map(entries.map((entry) => [entry.id, entry.data.term]));
const chapters = new Map((await getCollection('chapters')).map((c) => [c.id, c.data.title]));

/** The map part and the chapter that teach a term, from the shared concept list. */
function placesFor(id: string) {
  const parts = Object.values(PARTS).filter((part) => part.glossary === id);
  const taught = parts.find((part) => part.chapter && chapters.has(part.chapter));
  return {
    // The whole map explains "transformer", so that entry links to the map itself.
    map: parts[0] || id === 'transformer' ? withBase(mapPath(parts[0]?.id)) : undefined,
    chapter: taught?.chapter
      ? {
          href: withBase(`learn/${taught.chapter}/${taught.step ? `#${taught.step}` : ''}`),
          title: chapters.get(taught.chapter)!,
        }
      : undefined,
  };
}
for (const entry of entries) {
  for (const ref of entry.data.related) {
    if (!termById.has(ref.id)) {
      throw new Error(`Glossary entry "${entry.id}" lists unknown related term "${ref.id}"`);
    }
  }
}
---

<BaseLayout title="Glossary" description="Short definitions of the terms used on this site.">
  <section class="prose page">
    <h1>Glossary</h1>
    <dl class="glossary">
      {entries.map((entry) => {
        const places = placesFor(entry.id);
        return (
          <div class="entry target-highlight" id={entry.id}>
            <dt>
              <span class="token-chip">{entry.data.term}</span>
            </dt>
            <dd>
              <p>{entry.data.short}</p>
              {entry.data.related.length > 0 && (
                <p class="related">
                  See also{' '}
                  {entry.data.related.map((ref, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={`#${ref.id}`}>{termById.get(ref.id)}</a>
                    </>
                  ))}
                </p>
              )}
              {(places.map || places.chapter) && (
                <p class="related places">
                  {places.map && <a href={places.map}>See it on the map</a>}
                  {places.chapter && (
                    <a href={places.chapter.href}>Where it's taught, {places.chapter.title}</a>
                  )}
                </p>
              )}
            </dd>
          </div>
        );
      })}
    </dl>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12);
  }
  .entry {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-separator);
  }
  dt {
    font-weight: 600;
  }
  dt .token-chip {
    display: inline-block;
  }
  dd {
    margin: var(--space-2) 0 0;
  }
  dd p {
    margin: 0 0 var(--space-1);
  }
  .places {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .related {
    color: var(--color-text-secondary);
    font-size: var(--text-subheadline);
  }
</style>
