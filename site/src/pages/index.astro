---
import Figure from '../components/Figure.astro';
import HomeDemo from '../components/figures/HomeDemo.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { guessTree } from '../lib/demo-data';
import { withBase } from '../lib/paths';

const trees = [
  'Once upon a time, there was a',
  'The cat sat on the',
  'Lily wanted to play with her',
].map((prompt) => guessTree(prompt, { finish: true }));

// Small chips for the chapters, each underlined in the color of the part it teaches.
const CHAPTER_COLORS: Record<string, string> = {
  tokens: 'var(--color-text-secondary)',
  embeddings: 'var(--concept-position)',
  attention: 'var(--concept-query)',
  prediction: 'var(--concept-output)',
};
const chapters = (await getCollection('chapters', ({ data }) => !data.draft))
  .filter((c) => c.id in CHAPTER_COLORS)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Transformer Visualized"
  description="Follow a sentence through a real transformer, step by step, from a simple story to the exact math."
>
  <section class="hero container">
    <div class="hero-text">
      <h1>See inside a language model</h1>
      <p class="lede">A real model is guessing the next word. Tap a guess to pick it yourself.</p>
    </div>
    <Figure
      caption="A tiny model trained on short stories."
      description="A sentence split into tokens, with bars showing the model's top five guesses for the next token and their probabilities."
      wide={false}
    >
      <HomeDemo client:load trees={trees} />
    </Figure>
  </section>

  <section class="ways container" aria-label="Ways to start">
    <a class="way press" href={withBase('learn/')}>
      <span class="way-title">Learn from scratch</span>
      <span class="way-text">
        No math needed. Start with a story and go deeper when you like.
        <span class="way-chips" aria-hidden="true">
          {chapters.map((c) => (
            <span class="way-chip" style={`--chip-color: ${CHAPTER_COLORS[c.id]}`}>
              {c.data.title}
            </span>
          ))}
        </span>
      </span>
    </a>
    <a class="way press" href={withBase('learn/architecture/')}>
      <span class="way-title">The whole model</span>
      <span class="way-text">
        The diagram from the paper. Tap a part for its sizes, formula and PyTorch code.
      </span>
    </a>
    <a class="way press" href={withBase('review/')}>
      <span class="way-title">Quick review</span>
      <span class="way-text">Formulas, shapes and code for a refresher.</span>
    </a>
    <a class="way press" href={withBase('playground/')}>
      <span class="way-title">Playground</span>
      <span class="way-text">Type your own sentence and look inside the model.</span>
    </a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-16) var(--space-12);
  }
  .hero h1 {
    font-size: var(--text-hero);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }
  .lede {
    color: var(--color-text-secondary);
    font-size: var(--text-title-3);
    line-height: 1.4;
  }
  .ways {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-16);
  }
  .way {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
    min-height: var(--touch-target);
    padding: var(--space-5) var(--space-4);
    border-top: 1px solid var(--color-separator);
    color: var(--color-text);
    text-decoration: none;
  }
  a.way:hover .way-title {
    color: var(--color-accent);
  }
  .way-title {
    font-size: var(--text-title-3);
    font-weight: 600;
  }
  .way-text {
    color: var(--color-text-secondary);
  }
  .way-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  /* The same chip as the site's mark, with the chapter's color underneath. */
  .way-chip {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: inset 0 -3px 0 var(--chip-color);
    color: var(--color-text);
    font-size: var(--text-footnote);
  }
  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-block: var(--space-8);
    }
    .way {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
