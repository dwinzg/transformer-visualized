---
import { DEPTH_LABELS, DEPTHS } from '../lib/depth';
---

<fieldset class="depth-dial" data-depth-dial hidden>
  <legend>Explain it as</legend>
  <div class="options">
    {DEPTHS.map((depth) => (
      <label>
        <input type="radio" name="depth" value={depth} checked={depth === 'story'} />
        <span>{DEPTH_LABELS[depth]}</span>
      </label>
    ))}
  </div>
</fieldset>

<script>
  import {
    browserStorage,
    chooseDepth,
    DEPTH_EVENT,
    isDepth,
    readStoredDepth,
    type Depth,
  } from '../lib/depth';

  for (const dial of document.querySelectorAll<HTMLElement>('[data-depth-dial]')) {
    dial.hidden = false;
    const inputs = Array.from(dial.querySelectorAll<HTMLInputElement>('input[name="depth"]'));
    const select = (depth: Depth) => {
      for (const input of inputs) input.checked = input.value === depth;
    };
    select(readStoredDepth(browserStorage()));
    for (const input of inputs) {
      input.addEventListener('change', () => {
        if (isDepth(input.value)) chooseDepth(input.value);
      });
    }
    document.addEventListener(DEPTH_EVENT, (event) => {
      const depth = (event as CustomEvent<unknown>).detail;
      if (isDepth(depth)) select(depth);
    });
  }
</script>

<style>
  .depth-dial {
    border: 0;
    margin: 0;
    padding: 0;
  }
  legend {
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-footnote);
  }
  .options {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: var(--space-1);
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
  }
  label {
    position: relative;
  }
  input {
    position: absolute;
    opacity: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  span {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    font-size: var(--text-subheadline);
  }
  /* The selected segment's fill, border and shadow are shared with the level tabs in
     global.css's "picked" rule, so a selected depth control looks the same everywhere. */
  input:focus-visible + span {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }
</style>
