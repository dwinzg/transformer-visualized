---
---

<button type="button" class="theme-toggle" data-theme-toggle hidden aria-label="Switch color theme">
  <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<script>
  const THEMES = ['light', 'dark'] as const;
  type Theme = (typeof THEMES)[number];

  function explicitTheme(): Theme | undefined {
    const value = document.documentElement.dataset.theme;
    return value === 'light' || value === 'dark' ? value : undefined;
  }

  function currentTheme(): Theme {
    return (
      explicitTheme() ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
    );
  }

  /** Points the browser's theme-color at the reader's choice, or back at the system setting. */
  function syncThemeColor(): void {
    const chosen = explicitTheme();
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      const scheme = meta.dataset.scheme;
      meta.media = chosen
        ? scheme === chosen
          ? 'all'
          : 'not all'
        : `(prefers-color-scheme: ${scheme})`;
    }
  }

  syncThemeColor();
  const systemScheme = matchMedia('(prefers-color-scheme: dark)');
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    // Like the depth dial, the toggle only works with JS, so it stays hidden without it.
    button.hidden = false;
    const label = () =>
      button.setAttribute(
        'aria-label',
        currentTheme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
      );
    label();
    button.addEventListener('click', () => {
      const next = THEMES[currentTheme() === 'dark' ? 0 : 1];
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('tv-theme', next);
      } catch {
        // Storage can be unavailable (private mode); the choice then lasts for this page only.
      }
      syncThemeColor();
      label();
    });
    // Without an explicit choice, the label follows the system theme, so it stays correct if the
    // reader's OS switches (for example at sunset) while the page is open.
    systemScheme.addEventListener('change', () => {
      if (!explicitTheme()) label();
    });
  }
</script>

<style>
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: var(--touch-target);
    height: var(--touch-target);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--color-surface-2);
  }
  .icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: block;
    }
  }
</style>
