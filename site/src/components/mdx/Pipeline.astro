---
import { getCollection } from 'astro:content';
import Figure from '../Figure.astro';
import Island from '../figures/PipelineFigure.tsx';
import { withBase } from '../../lib/paths';

const chapters = await getCollection('chapters');
const ids = new Set(chapters.map((chapter) => chapter.id));
const links: Partial<Record<'tokens' | 'embeddings' | 'output', string>> = {};
if (ids.has('tokens')) links.tokens = withBase('learn/tokens/');
if (ids.has('embeddings')) links.embeddings = withBase('learn/embeddings/');
if (ids.has('prediction')) links.output = withBase('learn/prediction/');
---

<Figure
  caption="Every guess goes through these steps."
  description="The transformer's stages listed from tokens to output, each with a one sentence explanation you can open."
>
  <Island client:visible links={links} mapHref={withBase('learn/architecture/')} />
</Figure>
