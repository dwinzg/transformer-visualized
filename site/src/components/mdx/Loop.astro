---
import Figure from '../Figure.astro';

interface Props {
  /** Who does each step, and what they read or write. Code is shown as code. */
  steps: { who: 'Model' | 'Program' | 'Text'; text: string; code?: boolean }[];
  caption: string;
  /** Says that one step goes back to the first, for a loop that repeats. */
  repeats?: boolean;
}
const { steps, caption, repeats = false } = Astro.props;
---

<Figure
  caption={caption}
  description={`${steps.length} steps in order, each saying who acts and what they write.${repeats ? ' The last step leads back to the first.' : ''}`}
>
  <ol class="loop">
    {steps.map((step) => (
      <li class:list={['loop-step', `is-${step.who.toLowerCase()}`]}>
        <span class="loop-who">{step.who}</span>
        {step.code ? <code>{step.text}</code> : <span>{step.text}</span>}
      </li>
    ))}
  </ol>
  {repeats && <p class="loop-again">Then back to the first step, until the task is done.</p>}
</Figure>

<style>
  .loop {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: loop;
  }
  .loop-step {
    counter-increment: loop;
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-separator);
    border-left: 4px solid var(--color-separator);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    overflow-wrap: anywhere;
  }
  .loop-step.is-model {
    border-left-color: var(--concept-query);
  }
  .loop-step.is-program {
    border-left-color: var(--concept-output);
  }
  .loop-who {
    font-size: var(--text-footnote);
    font-weight: 600;
    color: var(--color-text-secondary);
  }
  .loop-who::before {
    content: counter(loop) '. ';
  }
  .loop-again {
    margin: var(--space-2) 0 0;
    font-size: var(--text-subheadline);
    color: var(--color-text-secondary);
  }
</style>
