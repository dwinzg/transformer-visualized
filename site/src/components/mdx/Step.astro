---
import { isPartId, mapPath, PARTS, type PartId } from '../../lib/concepts';
import { withBase } from '../../lib/paths';
import { stepId } from '../../lib/stepId';

interface Props {
  title: string;
  /** Adds a "See it on the map" link: true for the whole map, or a part to open it at. */
  map?: PartId | true;
}

// Steps on the same page can share a title (or one with no ASCII letters to slugify), so ids are
// deduplicated against the others on the page. Astro.locals is fresh for every request (one
// request per static page), so this needs no keying by pathname, the same way Term.astro counts
// its popovers.
const { title, map } = Astro.props;
const mapHref = map ? withBase(mapPath(isPartId(map) ? map : undefined)) : undefined;
// A step about one part of the model wears that part's color, the same as on the map.
const color = isPartId(map) ? PARTS[map].color : undefined;
const taken = ((Astro.locals as { stepIds?: Set<string> }).stepIds ??= new Set());
const id = stepId(title, taken);
taken.add(id);
---

<section class="step" id={id} data-step data-color={color} aria-labelledby={`${id}-title`}>
  <div class="step-head">
    <h2 id={`${id}-title`}>{title}</h2>
  </div>
  {mapHref && (
    <p class="map-link">
      <a href={mapHref}>See it on the map</a>
    </p>
  )}
  <div class="step-levels">
    <slot />
  </div>
</section>

<script>
  import {
    browserStorage,
    chooseDepth,
    closestAvailable,
    DEPTH_EVENT,
    DEPTH_LABELS,
    isDepth,
    readStoredDepth,
    type Depth,
  } from '../../lib/depth';

  function enhance(step: HTMLElement): void {
    const panels = Array.from(
      step.querySelectorAll<HTMLElement>(':scope > .step-levels > .level'),
    ).filter((panel) => isDepth(panel.dataset.level));
    if (panels.length < 2) return;
    const levels = panels.map((panel) => panel.dataset.level as Depth);
    const tablist = document.createElement('div');
    tablist.className = 'level-tabs';
    tablist.setAttribute('role', 'tablist');
    tablist.setAttribute('aria-label', 'Explanation level');
    const tabs = panels.map((panel, i) => {
      const level = levels[i];
      panel.id = `${step.id}-${level}`;
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.id = `${panel.id}-tab`;
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panel.id);
      tab.textContent = DEPTH_LABELS[level];
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tab.id);
      panel.tabIndex = 0;
      tablist.append(tab);
      return tab;
    });

    const show = (depth: Depth): void => {
      const chosen = closestAvailable(depth, levels);
      panels.forEach((panel, i) => {
        const selected = levels[i] === chosen;
        panel.hidden = !selected;
        tabs[i].setAttribute('aria-selected', String(selected));
        tabs[i].tabIndex = selected ? 0 : -1;
      });
    };

    tabs.forEach((tab, i) => {
      // chooseDepth dispatches DEPTH_EVENT, and the listener below updates every step.
      tab.addEventListener('click', () => chooseDepth(levels[i]));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const target =
          event.key === 'ArrowRight'
            ? (i + 1) % tabs.length
            : event.key === 'ArrowLeft'
              ? (i - 1 + tabs.length) % tabs.length
              : event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? last
                  : -1;
        if (target === -1) return;
        event.preventDefault();
        chooseDepth(levels[target]);
        tabs[target].focus();
      });
    });

    document.addEventListener(DEPTH_EVENT, (event) => {
      const depth = (event as CustomEvent<unknown>).detail;
      if (isDepth(depth)) show(depth);
    });

    step.querySelector('.step-head')?.append(tablist);
    step.classList.add('is-enhanced');
    show(readStoredDepth(browserStorage()));
  }

  document.querySelectorAll<HTMLElement>('[data-step]').forEach(enhance);
</script>

<style>
  .step {
    margin-block: var(--space-12);
  }
  .step-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }
  .step-head h2 {
    position: relative;
    margin: 0;
  }
  /* A thin bar in the part's color, beside the step's title. It only decorates, the title says it. */
  .step[data-color] .step-head h2 {
    padding-left: var(--space-4);
  }
  .step[data-color] .step-head h2::before {
    content: '';
    position: absolute;
    top: 0.2em;
    bottom: 0.2em;
    left: 0;
    width: 4px;
    border-radius: 2px;
    background: var(--step-color);
  }
  .step[data-color='neutral'] {
    --step-color: var(--color-text-secondary);
  }
  .step[data-color='position'] {
    --step-color: var(--concept-position);
  }
  .step[data-color='residual'] {
    --step-color: var(--concept-residual);
  }
  .step[data-color='output'] {
    --step-color: var(--concept-output);
  }
  .step[data-color='attention'] {
    --step-color: linear-gradient(
      var(--concept-query) 0 33%,
      var(--concept-key) 33% 66%,
      var(--concept-value) 66%
    );
  }
  .map-link {
    margin: calc(-1 * var(--space-4)) 0 var(--space-4);
    font-size: var(--text-footnote);
  }
  .map-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
  .step :global(.level-tabs) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .step :global(.level-tabs button) {
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-size: var(--text-footnote);
    cursor: pointer;
  }
  /* The selected tab looks different from the depth dial's segment on purpose, see global.css
     for why. */
</style>
