---
import Figure from '../Figure.astro';
import Island from '../figures/ContextWindowFigure.tsx';
import { contextWindow } from '../../lib/demo-data';

interface Props {
  note: string;
  filler: string;
  question: string;
  most: number;
  caption: string;
}
const { note, filler, question, most, caption } = Astro.props;
const { window, steps } = contextWindow(note, filler, question, most);
---

<Figure
  caption={caption}
  description="A slider adds sentences between a note and a question. A bar shows the whole text and outlines the last 128 tokens, the part the model can read. Bars show the model's likeliest next tokens."
>
  <Island client:visible window={window} steps={steps} note={note} question={question.trim()} />
</Figure>
