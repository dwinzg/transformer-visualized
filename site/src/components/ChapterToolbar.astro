---
import DepthDial from './DepthDial.astro';
---

<div class="chapter-toolbar" data-chapter-toolbar hidden>
  <DepthDial />
  <p class="step-count" aria-live="off"></p>
</div>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-chapter-toolbar]');
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
  if (toolbar) {
    toolbar.hidden = false;
    const count = toolbar.querySelector<HTMLElement>('.step-count');
    const show = (index: number) => {
      if (count) count.textContent = steps.length > 0 ? `Step ${index + 1} of ${steps.length}` : '';
    };
    show(0);
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) show(steps.indexOf(entry.target as HTMLElement));
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    steps.forEach((step) => observer.observe(step));

    // On phones the toolbar is fixed to the bottom; reserve its height so nothing hides under it.
    const reserve = () => {
      const fixed = getComputedStyle(toolbar).position === 'fixed';
      document.documentElement.style.setProperty(
        '--toolbar-reserve',
        fixed ? `${toolbar.offsetHeight}px` : '0px',
      );
    };
    reserve();
    new ResizeObserver(reserve).observe(toolbar);
    addEventListener('resize', reserve);
  }
</script>

<style>
  .chapter-toolbar {
    position: sticky;
    top: var(--header-height);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-block: var(--space-6);
    padding: var(--space-2) 0;
    background: var(--color-bg);
  }
  .chapter-toolbar[hidden] {
    display: none;
  }
  .step-count {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-footnote);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 52rem) {
    .chapter-toolbar {
      position: fixed;
      inset: auto 0 0 0;
      top: auto;
      margin: 0;
      padding: var(--space-2) var(--space-4) max(var(--space-2), env(safe-area-inset-bottom));
      background: var(--color-material);
      backdrop-filter: saturate(180%) blur(20px);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      border-top: 1px solid var(--color-separator);
    }
  }
  @media (max-width: 52rem) and (prefers-reduced-transparency: reduce) {
    .chapter-toolbar {
      background: var(--color-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
